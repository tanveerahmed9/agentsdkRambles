<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Azure OpenAI client -->
    <PackageReference Include="Azure.AI.OpenAI" Version="2.8.0-beta.1" />
    <!-- Microsoft.Extensions.AI: IChatClient abstraction + UseOpenTelemetry() -->
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.3.0" />
    <!-- Microsoft.Agents.AI: ChatClientAgent, AgentSession, AgentResponse -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.0.0-rc3" />
    <!-- OpenTelemetry core -->
    <PackageReference Include="OpenTelemetry" Version="1.9.0" />
    <!-- Azure Monitor exporter – sends traces & metrics to Application Insights -->
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.3.0" />
    <!-- Config -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <!-- Loads .env file into environment variables at startup -->
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update=".env">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
