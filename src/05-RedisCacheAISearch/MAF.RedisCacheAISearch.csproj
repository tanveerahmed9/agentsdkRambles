<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Azure OpenAI: chat + embeddings -->
    <PackageReference Include="Azure.AI.OpenAI" Version="2.8.0-beta.1" />
    <!-- Microsoft.Extensions.AI: IChatClient, IEmbeddingGenerator, middleware -->
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.3.0" />
    <!-- Microsoft.Agents.AI: ChatClientAgent, AgentSession, AgentResponse -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.0.0-rc3" />
    <!-- Azure AI Search: vector index + similarity search -->
    <PackageReference Include="Azure.Search.Documents" Version="11.6.0" />
    <!-- Redis: fast response storage -->
    <PackageReference Include="StackExchange.Redis" Version="2.8.0" />
    <!-- Config -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <!-- .env loader -->
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update=".env">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
